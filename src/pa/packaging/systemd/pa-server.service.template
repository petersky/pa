[Unit]
Description=PA Server ({{PA_INSTANCE_NAME}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{PA_BIN}} _service-run
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
LimitNOFILE=8192
MemoryMax=4G
{{CREDENTIAL_LINES}}
# config.json is authoritative for these mutable/secret values.  This also
# clears legacy values inherited from manager state or stale drop-ins.
UnsetEnvironment=PA_PEERS PA_SUBSCRIBED_REALMS PA_SYNC_TOKEN

{{ENV_LINES}}

StandardOutput=null
StandardError=append:{{PA_LOG_DIR}}/supervisor-bootstrap.log

[Install]
WantedBy=default.target
